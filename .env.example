# Docker Compose and systemd read this file; cargo run does NOT load it automatically.
BLOG_ADMIN_USERNAME=admin
# Required; choose your own strong password. Never commit .env.
BLOG_ADMIN_PASSWORD=
# Optional: defaults to BLOG_DATA_DIR/auth-providers.json (private, never public/).
# BLOG_OAUTH_CONFIG=/opt/blog/data/auth-providers.json
# With valid OAuth config and allow_password_login=false, password login is disabled.
